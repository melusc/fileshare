{
	"dependencies": {
		"he": "^2.0.0"
	},
	"devDependencies": {
		"@lusc/eslint-config": "^21.1.0",
		"@lusc/tsconfig": "^8.0.0",
		"@types/he": "^1.2.3",
		"@types/node": "^26.6.10",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"types": "workspace:^",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": "^26.13.1"
	},
	"exports": {
		".": "./dist/index.js",
		"./static": "./dist/static"
	},
	"license": "MIT",
	"name": "frontend",
	"private": true,
	"scripts": {
		"esbuild": "node esbuild.ts",
		"esbuild:w": "node esbuild.ts --watch",
		"check": "tsc -p tsconfig.build.json",
		"check:w": "tsc --watch -p tsconfig.build.json",
		"build": "pnpm run check && pnpm run esbuild",
		"build:w": "pnpm run '/^(check|esbuild):w$/'",
		"fmt": "eslint --fix"
